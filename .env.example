# Exemplo para desenvolvimento no host. Em produção, APP_BASE_URL deve usar
# HTTPS, SITE_ADDRESS deve ser o domínio público e os fluxos de autenticação exigem e-mail.
POSTGRES_DB=rangelab
POSTGRES_USER=rangelab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://rangelab:change-me@localhost:5432/rangelab
DATABASE_POOL_SIZE=10
APP_BASE_URL=http://localhost
SITE_ADDRESS=:80
ALLOW_INSECURE_LOCAL_HTTP=true
HTTP_PORT=80
HTTPS_PORT=443

# E-mail de confirmação de cadastro e recuperação (obrigatório em produção)
RESEND_API_KEY=
EMAIL_FROM=RangeLab <no-reply@example.com>
