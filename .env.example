# Copie para .env antes de usar valores de produção.
POSTGRES_DB=rangelab
POSTGRES_USER=rangelab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://rangelab:change-me@localhost:5432/rangelab
DATABASE_POOL_SIZE=10
APP_BASE_URL=http://localhost
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# E-mail de recuperação (opcional)
RESEND_API_KEY=
EMAIL_FROM=RangeLab <no-reply@example.com>
