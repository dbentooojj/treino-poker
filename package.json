{
  "name": "poker-spot-trainer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run typecheck && npm run lint && npm run build",
    "test:unit": "tsx --test tests/hrc-import.test.ts tests/training.test.ts tests/training-ui.test.tsx tests/poker-tools.test.ts tests/progress.test.ts tests/server-config.test.ts",
    "test:integration": "tsx --test tests/postgres.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "postgres": "3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Poker Spot Trainer"
}
